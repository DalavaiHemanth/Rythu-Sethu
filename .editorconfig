# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Don't edit files outside the project
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{json,jsonl}]
indent_size = 2
trim_trailing_whitespace = true
